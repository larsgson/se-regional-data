# Cloudflare R2 credentials for scripts/publish-cdn.sh
# Copy to .env (gitignored) and fill in. The script accepts either the
# CLOUDFLARE_* names below or their R2_* equivalents.
#
#   CLOUDFLARE_ACCESS_KEY_ID      R2 -> Manage R2 API Tokens -> create (Object Read & Write)
#   CLOUDFLARE_SECRET_ACCESS_KEY  shown ONCE when the token is created -- copy immediately
#   CLOUDFLARE_ACCOUNT_ID         Cloudflare dashboard -> R2 -> Overview -> "Account ID"
#   CLOUDFLARE_BUCKET             the bucket name serving cdn.bibel.wiki
#   PUBLIC_ASSET_BASE             public CDN base URL, e.g. https://cdn.bibel.wiki
#
# publish-cdn.sh auto-loads .env if present; no need to source it manually.

CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BUCKET=
PUBLIC_ASSET_BASE=https://cdn.bibel.wiki
